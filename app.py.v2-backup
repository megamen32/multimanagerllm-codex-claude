function populateMenuSwitch(){
  const cxSel=document.getElementById('menuCxSwitch');cxSel.innerHTML=''
  if(cxProfilesData&&cxProfilesData.profiles){
    cxProfilesData.profiles.forEach(p=>{
      const opt=document.createElement('option');opt.value=p.name;opt.textContent=p.name+(p.active?' ✓':'')
      if(p.active)opt.selected=true;cxSel.appendChild(opt)
    })
  } else {
    const opt=document.createElement('option');opt.textContent='загрузка...';cxSel.appendChild(opt)
    cxRefresh()
  }
  const ccSel=document.getElementById('menuCcSwitch');ccSel.innerHTML=''
  api('/api/cc-presets').then(data=>{
    (data.presets||[]).forEach(p=>{
      const opt=document.createElement('option');opt.value=p.name;opt.textContent=p.name+(p.active?' ✓':'')
      if(p.active)opt.selected=true;ccSel.appendChild(opt)
    })
  })
}
async function menuCxSwitch(){
  const name=document.getElementById('menuCxSwitch').value;if(!name)return
  setStatus('переключение...');await api('/api/cx-use',{name});cxRefresh();populateMenuSwitch();setStatus('готов')
}
async function menuCcSwitch(){
  const name=document.getElementById('menuCcSwitch').value;if(!name)return
  setStatus('переключение...');await api('/api/cc-use',{name});ccRefresh();populateMenuSwitch();setStatus('готов')
}
function populateMenuAccounts(){
  const el=document.getElementById('menuAccounts');el.innerHTML=''
  let hasData=false
  Object.entries(cxUsageCache).forEach(([name,u])=>{
    if(!u||u.error)return;hasData=true
    const rl=u.rate_limit||{},pw=rl.primary||{},sw=rl.secondary
    const pct=pw.used_percent!=null?Math.round(pw.used_percent)+'%':'?'
    const spct=sw&&sw.used_percent!=null?Math.round(sw.used_percent)+'%':'?'
    const pCol=pw.used_percent>80?'var(--danger)':pw.used_percent>50?'var(--warning)':'var(--accent2)'
    const div=document.createElement('div');div.className='menu-item';div.style.cssText='font-size:12px;flex-direction:column;align-items:stretch;padding:4px 8px'
    div.innerHTML=`<div style="display:flex;justify-content:space-between"><span>🔑 ${esc(name)}</span><span style="color:var(--muted)">${u.plan_type||''}</span></div>
      <div style="display:flex;gap:8px;font-size:11px;color:var(--muted);margin-top:2px">
        <span>5h: <b style="color:${pCol}">${pct}</b></span>
        <span>7d: <b>${spct}</b></span>
        ${u.token_expires_in?`<span>🔑 ${Math.round(u.token_expires_in/3600)}ч</span>`:''}
      </div>`
    el.appendChild(div)
  })
  Object.entries(cdOAuthCache).forEach(([name,c])=>{
    if(!c||!c.email)return;hasData=true
    const expInfo=c.expires_in>0?(c.expires_in<3600?'<span style="color:var(--danger)">истекает</span>':Math.round(c.expires_in/3600)+'ч'):'—'
    const div=document.createElement('div');div.className='menu-item';div.style.cssText='font-size:12px;padding:4px 8px'
    div.innerHTML=`<div style="display:flex;justify-content:space-between;width:100%"><span>📧 ${esc(c.email)}</span><span style="color:var(--muted)">токен ${expInfo}</span></div>`
    el.appendChild(div)
  })
  if(!hasData)el.innerHTML='<div class="menu-item" style="color:var(--muted);font-size:12px">Нет кэшированных данных. Открой Usage / Claude Desktop.</div>'
}
function toggleAutoRefresh(){
