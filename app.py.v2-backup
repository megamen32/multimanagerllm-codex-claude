// ===== UTILS =====
function esc(s){if(!s)return '';const d=document.createElement('div');d.textContent=s;return d.innerHTML}

// ===== CONSOLE =====
let consoleOpen = false;
let consoleCount = 0;
function conlog(level, msg, source){
  const el = document.getElementById('consoleBody');
  if(!el) return;
  const div = document.createElement('div');
  div.className = 'line ' + (level||'info') + (source ? ' '+source : '');
  const ts = new Date().toLocaleTimeString();
  div.textContent = `[${ts}] [${level||'info'}] ${msg}`;
  el.appendChild(div);
  el.scrollTop = el.scrollHeight;
  consoleCount++;
  const badge = document.getElementById('consoleBadge');
  if(badge) { badge.style.display='inline'; badge.textContent = consoleCount; }
  // Auto-show on errors
  if(level === 'error' && !consoleOpen) toggleConsole();
}
function toggleConsole(){
  const body = document.getElementById('consoleBody');
  consoleOpen = !consoleOpen;
  if(body) body.classList.toggle('open');
  if(consoleOpen) document.getElementById('consoleBar').style.boxShadow = '0 -4px 20px rgba(139,92,246,.15)';
  else document.getElementById('consoleBar').style.boxShadow = '';
}
function clearConsole(){
  const el = document.getElementById('consoleBody');
  if(el) el.innerHTML = '';
  consoleCount = 0;
  const badge = document.getElementById('consoleBadge');
  if(badge) { badge.style.display='none'; badge.textContent = '0'; }
}
// Capture frontend errors
window.onerror = function(msg, url, line, col, err){
  conlog('error', (err&&err.stack ? err.stack : msg) + (url ? ` (${url}:${line})` : ''));
};
window.addEventListener('unhandledrejection', function(e){
  conlog('error', 'Promise: ' + (e.reason ? (e.reason.stack||e.reason) : e));
});
// Patch console methods to also send to our console
['log','warn','error','info'].forEach(function(lvl){
  const orig = console[lvl];
  console[lvl] = function(){
    const msg = Array.from(arguments).map(a => typeof a === 'object' ? JSON.stringify(a) : String(a)).join(' ');
    conlog(lvl==='log'?'info':lvl, msg, 'frontend');
    return orig.apply(console, arguments);
  };
});
// Backend log endpoint
async function backendLog(level, msg){
  try { await fetch('/api/console-log', { method:'POST', headers:{'Content-Type':'application/json'}, body:JSON.stringify({level,msg}) }); }
  catch(e) {}
}

